# 复制成 .env 后填入真实值。
#
# `.env` 已在 .gitignore 里；本文件是**唯一**的配置真源说明。
# 代码里不留任何真实默认值 —— 缺哪一项由 `tools/run_e2e.py --doctor` 显式报出来。

# ── 收信：CF Temp Email Worker（必填）────────────────────────────────
# 管理密钥：建邮箱 / 走 /admin/* 端点用
TEMPMAIL_ADMIN_KEY=
# Worker 的根地址，形如 https://<你的-worker-子域>.workers.dev
TEMPMAIL_BASE=
# 建临时邮箱用哪个域名（必须是 Worker /health 里 domains 之一）
TEMPMAIL_DOMAIN=

# ── 收信后端（选填）──────────────────────────────────────────────────
# 目前只支持 cf。Remail 侧没有 Devin 项目号（下单必须带 projectId），
# 选了会由 --doctor 显式报错，详见 src/config.py 的 validate_remail()。
DEVIN_MAIL_BACKEND=cf

# ── 流程节拍（选填，默认值即实测值）──────────────────────────────────
# 等验证码邮件的总秒数
DEVIN_CODE_TIMEOUT=180
# 收件箱轮询间隔（秒）
DEVIN_CODE_POLL_INTERVAL=2
# 同一地址发码 429 的重试次数与退避基数（秒）
DEVIN_START_RETRIES=3
DEVIN_START_BACKOFF=25
# 单次 HTTP 超时（秒）
DEVIN_HTTP_TIMEOUT=30
