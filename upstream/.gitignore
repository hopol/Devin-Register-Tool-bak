# 凭据 —— 用通配，不要逐条列举（`.env.bak-xxx` 这类备份一定漏）
.env
.env.*
!.env.example

# 运行产物：台账 / 导出 / 探针输出
*.json
*.jsonl
*.csv
*.log
exports/

